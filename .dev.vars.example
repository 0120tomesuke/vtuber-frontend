# Local Cloudflare Worker development only. Never commit real values.
HOLODEX_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=
# Recommended permanent free delivery: a tiny GAS MailApp relay. The token is
# an arbitrary long shared secret stored in GAS Script Properties.
GAS_MAIL_RELAY_URL=
GAS_MAIL_RELAY_TOKEN=
# Optional Gmail API fallback. An unpublished OAuth app refresh token expires
# after about seven days.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Required only for the in-app management screen. Use a long unique value.
ADMIN_PASSWORD=
