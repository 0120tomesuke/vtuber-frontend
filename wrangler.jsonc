{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hololive-live-monitor",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-13",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/calendar.ics"
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hololive-live-monitor",
			"database_id": "73ede770-9b0c-489d-b80f-0b0a3966ca16",
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "MONITOR_QUEUE",
				"queue": "hololive-live-monitor-jobs"
			}
		],
		"consumers": [
			{
				"queue": "hololive-live-monitor-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 1,
				"max_retries": 2
			}
		]
	},
	"vars": {
		"EMAIL_FROM": "onboarding@resend.dev",
		"MAIL_DELIVERY_MODE": "resend_fallback_gas",
		"NOTIFICATION_EMAIL": "hololivemessage@gmail.com",
		"GMAIL_SENDER_EMAIL": "0120tomesuke@gmail.com"
	}
}
