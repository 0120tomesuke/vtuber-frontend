# Render also exposes these through its Environment settings.
NODE_ENV=development
PORT=3000
APP_TIME_ZONE=Asia/Tokyo

# Keep real values out of Git.
HOLODEX_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
DATABASE_URL=

# Use one of the supported email providers when notification migration starts.
RESEND_API_KEY=
NOTIFICATION_EMAIL=
EMAIL_FROM=

